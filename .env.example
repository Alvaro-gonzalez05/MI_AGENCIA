# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore: no se commitea.
#
# Los dos valores de abajo son PÚBLICOS por diseño: la publishable key viaja
# dentro de la app y la puede leer cualquiera que la instale. Lo que protege
# los datos es el RLS de la base, no el secreto de esta clave.
#
# Lo que NUNCA va acá ni en el repo: la service_role key y el access token
# personal de Supabase.
#
# Salen de: Dashboard -> Project Settings -> API Keys

SUPABASE_URL=https://TU_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
